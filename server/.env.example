PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/bloodlink?retryWrites=true&w=majority

# Generate a different value for each secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=replace-me-with-a-random-value-of-at-least-64-characters-for-access-tokens
REFRESH_TOKEN_SECRET=replace-me-with-a-different-random-value-of-at-least-64-characters-for-refresh-tokens

# Used only by `npm run seed:admin`; never expose these in the client.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Bloodlink Admin
